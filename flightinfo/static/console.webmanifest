{
  "id": "/console",
  "name": "ZenithBoard console",
  "short_name": "ZenithBoard",
  "description": "The settings of your ZenithBoard, from this Pi on your home network.",
  "start_url": "/console",
  "scope": "/console",
  "display": "standalone",
  "background_color": "#030303",
  "theme_color": "#030303",
  "icons": [
    { "src": "/static/console-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/static/console-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/static/console-icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
