[Unit]
Description=ZenithBoard aircraft-type data refresh (monthly)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Nice=10
ExecStartPre=/usr/bin/install -d -m 755 /var/lib/zenithboard/data
ExecStart=/usr/bin/python3 /opt/zenithboard/tools/update_types.py --out /var/lib/zenithboard/data/types.json --quiet
# It runs as root once a month and downloads a file: give it only what that needs.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/zenithboard
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
