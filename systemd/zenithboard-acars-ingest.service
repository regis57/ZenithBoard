[Unit]
Description=ZenithBoard ACARS ingester (UDP JSON -> SQLite, 7-day rolling retention)
After=network.target

[Service]
User=zenithboard
Group=zenithboard
Environment=ZENITHBOARD_CONFIG=/etc/zenithboard/config.env
ExecStart=/usr/bin/python3 /opt/zenithboard/acars/acars_ingest.py
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/zenithboard
UMask=0027

[Install]
WantedBy=multi-user.target
