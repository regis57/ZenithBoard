[Unit]
Description=ZenithBoard FlightInfo (dot-matrix wall server)
After=network.target

[Service]
User=zenithboard
Group=zenithboard
Environment=ZENITHBOARD_CONFIG=/etc/zenithboard/config.env
ExecStart=/usr/bin/python3 /opt/zenithboard/flightinfo/server.py
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
