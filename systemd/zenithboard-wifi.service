[Unit]
Description=ZenithBoard Wi-Fi settings (re-applies the country and the on/off choice at boot)
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/zenithboard/bin/zenithboard wifi apply
# iw reg set needs CAP_NET_ADMIN over netlink; rfkill needs /dev/rfkill, so devices are not hidden here
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
RestrictAddressFamilies=AF_UNIX AF_NETLINK
DeviceAllow=/dev/rfkill rw
# Sandbox, lighter: iw and rfkill keep the netlink access and the device above, and no system-call filter is applied,
# so a filter cannot quietly leave the radio in the wrong state at boot. Everything else is taken away.
# Measure with: systemd-analyze security zenithboard-wifi.service
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
