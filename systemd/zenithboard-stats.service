[Unit]
Description=ZenithBoard statistics (one sample every 15 minutes: messages, farthest aircraft, aircraft seen)

[Service]
Type=oneshot
ExecStart=/opt/zenithboard/bin/zenithboard stats run
# 120 s since 0.22.0: the sample may wait a few seconds for the farthest aircraft's route (lib/stats.sh)
TimeoutStartSec=120
# Runs as the wall's own user: it reads the decoder's stats.json and aircraft.json under /run and writes under
# /var/lib/zenithboard/stats, which that user owns. Nothing here needs root, so root is not used.
User=zenithboard
Group=zenithboard
ReadWritePaths=/var/lib/zenithboard
# AF_INET since 0.21.0: it asks the wall, on the loopback, which aircraft it could not name or draw, and since
# 0.22.0 which aircraft was the farthest. Nothing beyond this Pi: IPAddressAllow keeps it to the loopback.
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
# Sandbox: a script, run as zenithboard, that reads its settings and writes one file. Everything else is taken away from it, so
# a flaw in it, or in a tool it runs, stays inside a box. Measure with: systemd-analyze security zenithboard-stats.service
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
# 0022 since 0.99.13 (review B5, S2): 0077 made the files 0600, and `zenithboard stats` without sudo said 0 samples.
# They hold no position (counts, aircraft addresses and callsigns, the farthest aircraft's nearest city), what the
# /stats page shows anyway.
UMask=0022
