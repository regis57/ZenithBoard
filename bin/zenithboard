#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
# zenithboard - day-to-day control: units, radius, location, status.
set -u
HERE="$(dirname "$(readlink -f "$0")")"
# shellcheck source=lib/common.sh
. "$HERE/../lib/common.sh"
# shellcheck source=lib/adsb.sh
. "$HERE/../lib/adsb.sh"
# shellcheck source=lib/flightinfo.sh
. "$HERE/../lib/flightinfo.sh"
# shellcheck source=lib/acars.sh
. "$HERE/../lib/acars.sh"
# shellcheck source=lib/logs.sh
. "$HERE/../lib/logs.sh"
# shellcheck source=lib/uat.sh
. "$HERE/../lib/uat.sh"
# shellcheck source=lib/wifi.sh
. "$HERE/../lib/wifi.sh"
# shellcheck source=lib/network.sh
. "$HERE/../lib/network.sh"
# shellcheck source=lib/ddns.sh
. "$HERE/../lib/ddns.sh"
# shellcheck source=lib/update.sh
. "$HERE/../lib/update.sh"

usage() {
  cat <<USAGE
ZenithBoard $ZB_VERSION - ADSB Flight Info

  zenithboard status                    what is installed / running, MLAT check
  zenithboard config                    show the current settings
  zenithboard net status                saved connections, their addresses, default route, DNS
  zenithboard net static IP MASK GATEWAY [cloudflare|google|router|"DNS DNS"] [PROFILE]   fixed address (MASK: 255.255.255.0 or 24)
  zenithboard net dhcp [PROFILE]        back to an automatic address
  zenithboard ddns status|update|off    domain name (DuckDNS / No-IP / FreeDNS): state, refresh now, stop
  zenithboard ddns set PROVIDER NAME    duckdns|noip|freedns, then asks for the token / key (never on the command line)
  zenithboard wifi status               Wi-Fi: radio, country, connection, and wired-vs-Wi-Fi priority
  zenithboard wifi on|off               turn Wi-Fi on or off (kept after a reboot)
  zenithboard wifi country XX           Wi-Fi country code, e.g. FR BE CH DE GB US (kept after a reboot)
  zenithboard wifi scan                 networks in range with signal strength
  zenithboard wifi connect SSID         save and join a network (asks for the password; hidden: add --hidden)
  zenithboard wifi install-nm           install NetworkManager if this Pi does not have it (run it with the cable plugged in)
  zenithboard wifi list|forget SSID     saved networks / forget one
  zenithboard region world|us           where the antenna is (us adds the optional 978 MHz UAT step in the menu)
  zenithboard units metric|imperial     km, km/h, m   |   mi, knots, ft
  zenithboard radius 1|2|5|10|15|30|50  wall detection radius (in your unit: km or miles)
  zenithboard location LAT LON [ALT_M]  set the antenna position EVERYWHERE it is stored
  zenithboard color amber|green|red|white   dot colour of every wall (amber is the default)
  zenithboard mode dots|flap            look of the wall: dot matrix (default) or split-flap airport board
  zenithboard cycle SECONDS             seconds each aircraft stays on the wall
  zenithboard photos on|off             aircraft photos on the wall (needs internet on the Pi)
  zenithboard photos test [HEX]         check that this Pi can fetch photos from Planespotters
  zenithboard routes on|off             show where each flight comes from / goes to (looked up by callsign, needs internet)
  zenithboard data update               refresh the aircraft model list now (names for the silhouettes)
  zenithboard data auto on|off          monthly automatic refresh of that list (default: on)
  zenithboard data status               when it was last refreshed
  zenithboard update                    upgrade ZenithBoard + decoder + feeders + ACARS + Grafana
  zenithboard update list               what is installed and can be updated one by one
  zenithboard update only NAME...       update just those (e.g. readsb flightinfo)
  zenithboard mlat-guard                re-enforce a single MLAT client
  zenithboard logs [flightinfo|acars|decoder|uat]   show the last 100 lines of a service
  zenithboard logs usage|review         size of the system logs / size + recent warnings
  zenithboard logs limit MB|default     cap the size of the system logs (10-2000 MB)
  zenithboard logs clean                delete ALL logs now
  zenithboard logs auto on|off|status   automatic daily clean-up that keeps the last 7 days (off by default)
  zenithboard menu                      open the installer menu (add / remove components)
USAGE
}

root_or_die() { [ "$(id -u)" -eq 0 ] || die "This command changes settings: run it with sudo."; }

show_state() { # show_state "Label" check_fn service
  local st="not installed"
  if "$2"; then if unit_active "$3"; then st="${C_G}running${C_0}"; else st="${C_R}installed, NOT running${C_0}"; fi; fi
  printf '  %-26s %s\n' "$1" "$st"
}

cmd_status() {
  local dec; dec=$(installed_decoder)
  echo "${C_B}ZenithBoard $ZB_VERSION${C_0}   units: $(cfg_get UNITS metric)   position: $(cfg_get LAT ?) , $(cfg_get LON ?)"
  if wifi_has_nm && [ -n "$(wifi_iface)" ]; then echo "Wi-Fi: $(wifi_summary)   (details: zenithboard wifi status)"; fi
  if [ "$(cfg_get DDNS_PROVIDER none)" != none ]; then echo "Domain name: $(ddns_summary)   (details: zenithboard ddns status)"; fi
  echo "Hardware: $(pi_model || true)  RAM: $(mem_avail_mb) / $(mem_total_mb) MB free$(is_low_mem && echo '  (low-memory board: skip ACARS/Grafana)')"
  echo "Decoder / feeders:"
  if [ -n "$dec" ]; then show_state "Decoder ($dec)" true "$dec"; else echo "  Decoder                    not installed"; fi
  show_state "ADSB Exchange" is_adsbx adsbexchange-feed
  show_state "FlightAware (piaware)" is_piaware piaware
  show_state "Flightradar24" is_fr24 fr24feed
  show_state "Plane Finder" is_planefinder pfclient
  if is_region_us || is_uat978; then show_state "978 MHz UAT (dump978-fa)" is_uat978 dump978-fa; fi
  echo "Displays:"
  show_state "FlightInfo wall" is_flightinfo zenithboard-flightinfo
  show_state "ACARS decoder" is_acars zenithboard-acarsdec
  show_state "ACARS ingester" is_acars zenithboard-acars-ingest
  show_state "Grafana" is_grafana grafana-server
  local n; n=$(mlat_count)
  if [ "${n:-0}" -le 1 ]; then echo "MLAT clients running: ${n:-0}  ${C_G}(OK: max 1)${C_0}"; else echo "MLAT clients running: $n  ${C_R}(too many! run: sudo zenithboard mlat-guard)${C_0}"; fi
  local j; j=$(decoder_json)
  if [ -f "$j" ]; then echo "Aircraft in decoder right now: $(grep -o '"hex"' "$j" | wc -l)"; fi
  if is_uat978 && [ -f /run/skyaware978/aircraft.json ]; then echo "Aircraft on 978 MHz right now:  $(grep -o '"hex"' /run/skyaware978/aircraft.json | wc -l)"; fi
  if is_flightinfo; then
    echo "Wall:     http://$(local_ip):$(cfg_get PORT 8080)/"
    echo "Aircraft photos (Planespotters): $( [ "$(cfg_get SHOW_PHOTOS 1)" = 1 ] && echo "ON" || echo "OFF (turn on: sudo zenithboard photos on)" )"
    echo "Flight routes (adsbdb.com):      $( [ "$(cfg_get SHOW_ROUTES 1)" = 1 ] && echo "ON" || echo "OFF (turn on: sudo zenithboard routes on)" )"
    data_refresh_status
  fi
  if is_adsbx; then
    local m; m=$(local_map_path)
    echo "Local map: http://$(local_ip)$m   (port 80, no clash with the wall on $(cfg_get PORT 8080))"
    echo "ADSB Exchange feed status: https://www.adsbexchange.com/myip/"
  fi
  is_acars && echo "ACARS:    http://$(local_ip):3000/"
}

# The map served on port 80 comes from readsb (tar1090) or from the optional ADSB Exchange web interface,
# so look for the one that is actually installed instead of guessing.
local_map_path() {
  local d
  for d in /usr/local/share/tar1090/html /usr/share/tar1090/html; do [ -d "$d" ] && { echo "/tar1090/"; return; }; done
  for d in /usr/local/share/adsbexchange/html /usr/share/adsbexchange/html; do [ -d "$d" ] && { echo "/adsbx/"; return; }; done
  echo "/tar1090/  (or /adsbx/ if you installed the ADSB Exchange web interface)"
}

data_refresh_status() {
  local f="$ZB_DATA/data/types.json"
  echo "Monthly aircraft data refresh: $( [ "$(cfg_get AUTO_DATA_REFRESH 1)" = 1 ] && echo ON || echo OFF )"
  if [ -f "$f" ]; then
    python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print("Aircraft list: %s types, downloaded %s" % (d.get("count"), d.get("updated")))' "$f" 2>/dev/null || echo "Aircraft list: present but unreadable (run: sudo zenithboard data update)"
  elif [ ! -x "$ZB_DATA" ]; then
    echo "Aircraft list: cannot be checked by $(id -un) (older install: run 'sudo zenithboard update' once to fix the folder permissions)"
  else
    echo "Aircraft list: not downloaded (built-in list in use; run: sudo zenithboard data update)"
  fi
}

cmd_config() { echo "# $ZB_CONFIG"; cat "$ZB_CONFIG" 2>/dev/null || echo "(no configuration yet - run: sudo ./install.sh)"; }

case "${1:-}" in
  status) cmd_status ;;
  config|"show") cmd_config ;;
  units)
    root_or_die; valid_units "${2:-}" || die "Usage: zenithboard units metric|imperial"
    cfg_set UNITS "$2"; restart_flightinfo
    echo "Units are now $2. Radius ($(cfg_get RADIUS)) is read as $( [ "$2" = imperial ] && echo miles || echo km ). Tablets with their own on-screen override: tap the gear on the wall." ;;
  radius)
    root_or_die; valid_radius "${2:-}" || die "Radius must be one of: $RADIUS_PRESETS"
    cfg_set RADIUS "$2"; restart_flightinfo; echo "Radius: $2 $( [ "$(cfg_get UNITS)" = imperial ] && echo mi || echo km )" ;;
  location)
    root_or_die; valid_lat "${2:-x}" && valid_lon "${3:-x}" || die "Usage: zenithboard location LAT LON [ALT_M]   e.g. 49.1193 6.1757 180"
    zb_apply_location "$2" "$3" "${4:-}" ;;
  color|colour)
    root_or_die; valid_theme "${2:-}" || die "Usage: zenithboard color amber|green|red|white"
    cfg_set THEME "$2"; restart_flightinfo
    echo "Wall colour is now $2 (tablets that picked their own colour with the gear keep it: use the gear's Reset)." ;;
  data)
    case "${2:-status}" in
      update) root_or_die; ensure_zb_user; data_refresh_now ;;
      auto)
        root_or_die
        case "${3:-}" in on) cfg_set AUTO_DATA_REFRESH 1 ;; off) cfg_set AUTO_DATA_REFRESH 0 ;; *) die "Usage: zenithboard data auto on|off" ;; esac
        data_refresh_apply
        echo "Monthly aircraft data refresh: $( [ "$(cfg_get AUTO_DATA_REFRESH 1)" = 1 ] && echo ON || echo OFF )" ;;
      status) data_refresh_status ;;
      *) die "Usage: zenithboard data update | auto on|off | status" ;;
    esac ;;
  config-set)
    root_or_die; [ -n "${2:-}" ] || die "Usage: zenithboard config-set KEY VALUE"; cfg_set "$2" "${3:-}"; restart_flightinfo ;;
  mode|style)
    case "${2:-}" in
      dots|flap) root_or_die; cfg_set DISPLAY_MODE "$2"; restart_flightinfo
                 echo "Look of the wall: $2. The wall reloads by itself. A tablet that chose its own look keeps it: open the gear on the wall and press Reset, or use  ?mode=$2  in its address." ;;
      "") echo "Look of the wall: $(cfg_get DISPLAY_MODE dots)   (change: sudo zenithboard mode dots|flap)" ;;
      *) die "Usage: zenithboard mode dots|flap" ;;
    esac ;;
  cycle)
    root_or_die; is_number "${2:-x}" || die "Usage: zenithboard cycle SECONDS"; cfg_set CYCLE_SECONDS "$2"; restart_flightinfo ;;
  photos)
    case "${2:-}" in
      on)  root_or_die; cfg_set SHOW_PHOTOS 1; restart_flightinfo; echo "Aircraft photos are ON. The wall reloads by itself within a few seconds." ;;
      off) root_or_die; cfg_set SHOW_PHOTOS 0; restart_flightinfo; echo "Aircraft photos are OFF: the animated sky scene is shown instead." ;;
      test) python3 "$ZB_HOME/tools/photo_check.py" "${3:-}" ;;
      *) die "Usage: zenithboard photos on|off|test [HEX]" ;;
    esac ;;
  routes)
    [ "${2:-}" != test ] || { python3 "$ZB_HOME/tools/route_check.py" "${3:-}"; exit $?; }
    root_or_die
    case "${2:-}" in
      on)  cfg_set SHOW_ROUTES 1; restart_flightinfo; echo "Flight routes are ON (origin and destination, looked up by callsign). The wall reloads by itself." ;;
      off) cfg_set SHOW_ROUTES 0; restart_flightinfo; echo "Flight routes are OFF: no callsign is sent to the internet." ;;
      *) die "Usage: zenithboard routes on|off|test [CALLSIGN]" ;;
    esac ;;
  mlat-guard) root_or_die; zb_mlat_guard ;;
  update)
    case "${2:-}" in
      list) zb_update_list ;;
      only) root_or_die; [ -n "${3:-}" ] || die "Usage: sudo zenithboard update only NAME...   (names: zenithboard readsb dump1090 adsbx piaware fr24 planefinder flightinfo acars; see: zenithboard update list)"; shift 2; zb_update --only "$@" ;;
      *) root_or_die; zb_update "${2:-}" ;;
    esac ;;
  update-components) root_or_die; shift; zb_update_components "$@" ;;
  net)
    case "${2:-status}" in
      status) net_status ;;
      static)
        root_or_die; net_has_nm || die "A fixed address needs NetworkManager."
        [ -n "${3:-}" ] && [ -n "${4:-}" ] && [ -n "${5:-}" ] || die "Usage: sudo zenithboard net static IP MASK GATEWAY [cloudflare|google|router|\"DNS DNS\"] [PROFILE-NAME]"
        net_valid_host_ip "$3" || die "Not a valid address: $3"
        p=$(net_to_prefix "$4") || die "Not a valid mask: $4 (try 255.255.255.0 or 24)"
        net_valid_host_ip "$5" || die "Not a valid gateway: $5"
        net_same_subnet "$3" "$5" "$p" || die "The gateway $5 is not in the network of $3/$p: the Pi would lose its connection."
        dns=$(net_dns_preset "${6:-cloudflare}" "$5"); net_valid_dns_list "$dns" || die "Not a valid DNS list: ${6:-}"
        if [ -n "${7:-}" ]; then u=$(net_profiles | awk -F'\t' -v n="$7" '$3==n {print $1; exit}'); else u=$(net_default_profile); fi
        [ -n "$u" ] || die "Which connection? Give its name (see: zenithboard net status) as the last argument."
        net_session_uses "$u" && warn "You are connected through this connection: the session will drop. Reconnect at $3."
        net_apply_static "$u" "$3" "$p" "$5" "$dns" && echo "Fixed address saved: $3/$p via $5, DNS $dns (kept after a reboot). Undo: sudo zenithboard net dhcp" || die "Could not apply it. Check: zenithboard net status" ;;
      dhcp)
        root_or_die; net_has_nm || die "NetworkManager is not running."
        if [ -n "${3:-}" ]; then u=$(net_profiles | awk -F'\t' -v n="$3" '$3==n {print $1; exit}'); else u=$(net_default_profile); fi
        [ -n "$u" ] || die "Which connection? Give its name (see: zenithboard net status)."
        net_apply_dhcp "$u" && echo "Automatic address restored." || die "Could not apply it." ;;
      *) die "Usage: zenithboard net status|static IP MASK GATEWAY [DNS]|dhcp" ;;
    esac ;;
  ddns)
    case "${2:-status}" in
      status) ddns_status; [ "$(cfg_get DDNS_PROVIDER none)" = none ] || { echo; ddns_links; } ;;
      update) root_or_die; ddns_update && cat "$DDNS_STATE" 2>/dev/null || { cat "$DDNS_STATE" 2>/dev/null; exit 1; } ;;
      off) root_or_die; ddns_off; echo "Domain name is off; the saved key was deleted." ;;
      set)
        root_or_die; [ -n "${3:-}" ] && [ -n "${4:-}" ] || die "Usage: sudo zenithboard ddns set duckdns|noip|freedns FULL.NAME"
        u=""; if [ "$3" = noip ]; then read -rp "No-IP DDNS key user name: " u; read -rsp "No-IP DDNS key password: " s; echo
        else read -rsp "Token (or the whole FreeDNS direct URL): " s; echo; fi
        ddns_set "$3" "$4" "$u" "$s" ;;
      *) die "Usage: zenithboard ddns status|set PROVIDER NAME|update|off" ;;
    esac ;;
  wifi)
    case "${2:-status}" in
      status) wifi_status ;;
      on|off) root_or_die; wifi_has_nm || die "Wi-Fi needs NetworkManager. Install it with:  sudo zenithboard wifi install-nm"; [ "$2" = off ] && wifi_session_on_wifi && warn "You seem to be connected through Wi-Fi: turning it off will cut this session."
              [ "$2" = on ] && [ -z "$(wifi_country_now)" ] && die "Set the country first:  sudo zenithboard wifi country FR"
              wifi_set_radio "$2" && echo "Wi-Fi is $2 (kept after a reboot)." ;;
      country) root_or_die; wifi_set_country "${3:-}" && echo "Wi-Fi country: $3 (kept after a reboot)." ;;
      scan) wifi_has_nm || die "Wi-Fi needs NetworkManager."; wifi_radio_on || die "Wi-Fi is off: sudo zenithboard wifi on"
            wifi_scan | while IFS=$'\t' read -r ssid sig sec; do printf '%-6s %3s%%  %-32s %s\n' "$(wifi_bars "$sig")" "$sig" "$ssid" "$sec"; done ;;
      connect)
        root_or_die; wifi_has_nm || die "Wi-Fi needs NetworkManager."; [ -n "${3:-}" ] || die "Usage: zenithboard wifi connect SSID [--hidden]   (the password is asked, never typed on the command line)"
        [ -n "$(wifi_country_now)" ] || die "Set the country first:  sudo zenithboard wifi country FR"
        wifi_session_on_wifi && warn "You seem to be connected through Wi-Fi: this may cut your session."
        psk="${ZB_WIFI_PSK:-}"
        [ -n "$psk" ] || { read -rsp "Password for \"$3\" (empty = open network): " psk; echo; }
        hid=0; [ "${4:-}" = --hidden ] && hid=1
        wifi_connect "$3" "$psk" "$hid" wpa-psk ;;
      list) wifi_saved | cut -f2 ;;
      forget)
        root_or_die; [ -n "${3:-}" ] || die "Usage: zenithboard wifi forget SSID"
        u=$(wifi_saved | awk -F'\t' -v n="$3" '$2==n || $2 ~ ("^zenithboard-wifi-" n "-") {print $1; exit}')
        [ -n "$u" ] || die "No saved network called $3 (see: zenithboard wifi list)"
        wifi_forget "$u" && echo "Forgotten: $3" ;;
      install-nm) root_or_die; wifi_install_nm ;;
      apply) root_or_die; wifi_apply ;;
      *) die "Usage: zenithboard wifi status|on|off|country XX|scan|connect SSID|list|forget SSID" ;;
    esac ;;
  region)
    case "${2:-}" in
      world|us) root_or_die; cfg_set REGION "$2"; echo "Region: $2. $( [ "$2" = us ] && echo "Menu 1 ADSB now offers the 978 MHz UAT step (needs a 2nd dongle)." || echo "1090 MHz only." )" ;;
      "") echo "Region: $(cfg_get REGION world)" ;;
      *) die "Usage: zenithboard region world|us" ;;
    esac ;;
  logs)
    case "${2:-flightinfo}" in
      usage) logs_usage ;;
      review) logs_review ;;
      limit) root_or_die; logs_set_limit "${3:-}" ;;
      clean) root_or_die; logs_clean "${3:-all}" ;;
      auto) root_or_die; case "${3:-status}" in on) logs_auto_on; echo "Automatic cleaning is ON: every day, logs older than 7 days are removed." ;; off) logs_auto_off; echo "Automatic cleaning is OFF." ;; status) echo "Automatic cleaning: $(logs_auto_state)" ;; *) die "Usage: zenithboard logs auto on|off|status" ;; esac ;;
      auto-run) root_or_die; logs_auto_run ;;
      uat) journalctl -u dump978-fa -u skyaware978 -n 100 --no-pager ;;
      flightinfo) journalctl -u zenithboard-flightinfo -n 100 --no-pager ;;
      acars) journalctl -u zenithboard-acarsdec -u zenithboard-acars-ingest -n 100 --no-pager ;;
      decoder) journalctl -u "$(cfg_get DECODER readsb)" -n 100 --no-pager ;;
      *) die "Usage: zenithboard logs [flightinfo|acars|decoder]" ;;
    esac ;;
  menu) root_or_die; exec "$HERE/../install.sh" ;;
  version|--version) echo "ZenithBoard $ZB_VERSION" ;;
  help|-h|--help|"") usage ;;
  *) usage; exit 1 ;;
esac
