#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
# zenithboard - day-to-day control: units, radius, location, status.
set -u
HERE="$(dirname "$(readlink -f "$0")")"
# shellcheck source=lib/common.sh
. "$HERE/../lib/common.sh"
# shellcheck source=lib/adsb.sh
. "$HERE/../lib/adsb.sh"
# shellcheck source=lib/flightinfo.sh
. "$HERE/../lib/flightinfo.sh"
# shellcheck source=lib/acars.sh
. "$HERE/../lib/acars.sh"
# shellcheck source=lib/update.sh
. "$HERE/../lib/update.sh"

usage() {
  cat <<USAGE
ZenithBoard $ZB_VERSION - ADSB Flight Info

  zenithboard status                    what is installed / running, MLAT check
  zenithboard config                    show the current settings
  zenithboard units metric|imperial     km, km/h, m   |   mi, knots, ft
  zenithboard radius 1|2|5|10|15|30|50  wall detection radius (in your unit: km or miles)
  zenithboard location LAT LON [ALT_M]  set the antenna position EVERYWHERE it is stored
  zenithboard color amber|green|red|white   dot colour of every wall (amber is the default)
  zenithboard cycle SECONDS             seconds each aircraft stays on the wall
  zenithboard photos on|off             aircraft photos on the wall (needs internet on the Pi)
  zenithboard logo add ICAO image       airline logo from YOUR image file, e.g.: zenithboard logo add AFR ~/af.png
  zenithboard logo fetch ICAO           download + convert from LOGO_URL_TEMPLATE
  zenithboard logo remove ICAO | list   manage the logo library (/var/lib/zenithboard/logos)
  zenithboard data update               download the full airline-name list (OpenFlights)
  zenithboard update                    upgrade ZenithBoard + decoder + feeders + ACARS + Grafana
  zenithboard mlat-guard                re-enforce a single MLAT client
  zenithboard logs [flightinfo|acars|decoder]
  zenithboard menu                      open the installer menu (add / remove components)
USAGE
}

root_or_die() { [ "$(id -u)" -eq 0 ] || die "This command changes settings: run it with sudo."; }

show_state() { # show_state "Label" check_fn service
  local st="not installed"
  if "$2"; then if unit_active "$3"; then st="${C_G}running${C_0}"; else st="${C_R}installed, NOT running${C_0}"; fi; fi
  printf '  %-26s %s\n' "$1" "$st"
}

cmd_status() {
  local dec; dec=$(installed_decoder)
  echo "${C_B}ZenithBoard $ZB_VERSION${C_0}   units: $(cfg_get UNITS metric)   position: $(cfg_get LAT ?) , $(cfg_get LON ?)"
  echo "Hardware: $(pi_model || true)  RAM: $(mem_avail_mb) / $(mem_total_mb) MB free$(is_low_mem && echo '  (low-memory board: skip ACARS/Grafana)')"
  echo "Decoder / feeders:"
  if [ -n "$dec" ]; then show_state "Decoder ($dec)" true "$dec"; else echo "  Decoder                    not installed"; fi
  show_state "ADSB Exchange" is_adsbx adsbexchange-feed
  show_state "FlightAware (piaware)" is_piaware piaware
  show_state "Flightradar24" is_fr24 fr24feed
  show_state "Plane Finder" is_planefinder pfclient
  echo "Displays:"
  show_state "FlightInfo wall" is_flightinfo zenithboard-flightinfo
  show_state "ACARS decoder" is_acars zenithboard-acarsdec
  show_state "ACARS ingester" is_acars zenithboard-acars-ingest
  show_state "Grafana" is_grafana grafana-server
  local n; n=$(mlat_count)
  if [ "${n:-0}" -le 1 ]; then echo "MLAT clients running: ${n:-0}  ${C_G}(OK: max 1)${C_0}"; else echo "MLAT clients running: $n  ${C_R}(too many! run: sudo zenithboard mlat-guard)${C_0}"; fi
  local j; j=$(decoder_json)
  if [ -f "$j" ]; then echo "Aircraft in decoder right now: $(grep -o '"hex"' "$j" | wc -l)"; fi
  is_flightinfo && echo "Wall:     http://$(local_ip):$(cfg_get PORT 8080)/"
  if is_adsbx; then
    echo "ADSB Exchange map (local): http://$(local_ip)/adsbx/   (port 80, no clash with the wall on $(cfg_get PORT 8080))"
    echo "ADSB Exchange feed status: https://www.adsbexchange.com/myip/"
  fi
  is_acars && echo "ACARS:    http://$(local_ip):3000/"
}

cmd_config() { echo "# $ZB_CONFIG"; cat "$ZB_CONFIG" 2>/dev/null || echo "(no configuration yet - run: sudo ./install.sh)"; }

case "${1:-}" in
  status) cmd_status ;;
  config|"show") cmd_config ;;
  units)
    root_or_die; valid_units "${2:-}" || die "Usage: zenithboard units metric|imperial"
    cfg_set UNITS "$2"; restart_flightinfo
    echo "Units are now $2. Radius ($(cfg_get RADIUS)) is read as $( [ "$2" = imperial ] && echo miles || echo km ). Tablets with their own on-screen override: tap the gear on the wall." ;;
  radius)
    root_or_die; valid_radius "${2:-}" || die "Radius must be one of: $RADIUS_PRESETS"
    cfg_set RADIUS "$2"; restart_flightinfo; echo "Radius: $2 $( [ "$(cfg_get UNITS)" = imperial ] && echo mi || echo km )" ;;
  location)
    root_or_die; valid_lat "${2:-x}" && valid_lon "${3:-x}" || die "Usage: zenithboard location LAT LON [ALT_M]   e.g. 49.246 6.223 210"
    zb_apply_location "$2" "$3" "${4:-}" ;;
  color|colour)
    root_or_die; valid_theme "${2:-}" || die "Usage: zenithboard color amber|green|red|white"
    cfg_set THEME "$2"; restart_flightinfo
    echo "Wall colour is now $2 (tablets that picked their own colour with the gear keep it: use the gear's Reset)." ;;
  logo)
    root_or_die; shift
    python3 -c 'import PIL' 2>/dev/null || { log "Installing Pillow (image library)"; apt_install python3-pil; }
    ensure_zb_user; ZENITHBOARD_CONFIG="$ZB_CONFIG" python3 "$HERE/../tools/logo_tool.py" "$@" ;;
  data)
    root_or_die; [ "${2:-}" = update ] || die "Usage: zenithboard data update"
    ensure_zb_user; python3 "$HERE/../tools/update_airlines.py" --out "$ZB_DATA/data/airlines.json" && restart_flightinfo ;;
  config-set)
    root_or_die; [ -n "${2:-}" ] || die "Usage: zenithboard config-set KEY VALUE"; cfg_set "$2" "${3:-}"; restart_flightinfo ;;
  cycle)
    root_or_die; is_number "${2:-x}" || die "Usage: zenithboard cycle SECONDS"; cfg_set CYCLE_SECONDS "$2"; restart_flightinfo ;;
  photos)
    root_or_die; case "${2:-}" in on) cfg_set SHOW_PHOTOS 1 ;; off) cfg_set SHOW_PHOTOS 0 ;; *) die "Usage: zenithboard photos on|off" ;; esac ;;
  mlat-guard) root_or_die; zb_mlat_guard ;;
  update) root_or_die; zb_update "${2:-}" ;;
  update-components) root_or_die; zb_update_components ;;
  logs)
    case "${2:-flightinfo}" in
      flightinfo) journalctl -u zenithboard-flightinfo -n 100 --no-pager ;;
      acars) journalctl -u zenithboard-acarsdec -u zenithboard-acars-ingest -n 100 --no-pager ;;
      decoder) journalctl -u "$(cfg_get DECODER readsb)" -n 100 --no-pager ;;
      *) die "Usage: zenithboard logs [flightinfo|acars|decoder]" ;;
    esac ;;
  menu) root_or_die; exec "$HERE/../install.sh" ;;
  version|--version) echo "ZenithBoard $ZB_VERSION" ;;
  help|-h|--help|"") usage ;;
  *) usage; exit 1 ;;
esac
