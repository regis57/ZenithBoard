zb_tmp_init   # the private folder for downloads, made here in the main shell (see zb_tmp in lib/common.sh)

usage() {
  cat <<USAGE
ZenithBoard $ZB_VERSION - ADSB Flight Info

  zenithboard status                    what is installed / running, MLAT check
  zenithboard config                    show the current settings
  zenithboard net status                saved connections, their addresses, default route, DNS
  zenithboard net static IP MASK GATEWAY [cloudflare|google|router|"DNS DNS"] [PROFILE]   fixed address (MASK: 255.255.255.0 or 24)
  zenithboard net dhcp [PROFILE]        back to an automatic address
  zenithboard health                    one screen: power, temperature, memory, card, how the last boot ended, problems in the logs
  zenithboard memory                    memory, threads and open files, service by service (sudo: exact figures)
  zenithboard watchdog|netwatch|keeplogs on|off|status   hardware watchdog / network watchdog / logs kept after a restart (all off by default)
  zenithboard gain check                is the dongle gain right? (reads the decoder statistics, gives advice)
  zenithboard gain set DB|max|default|up|down   change the gain (one step at a time is best); steps: zenithboard gain steps
  zenithboard gain log on|off|status|show|clear   record one measurement every 15 min for 24 h, as a CSV table you can open in a spreadsheet
  zenithboard ddns status|update|test|off  domain name (DuckDNS / No-IP / FreeDNS): state, refresh now, stop
  zenithboard ddns set PROVIDER NAME    duckdns|noip|freedns, then asks for the token / key (never on the command line)
  zenithboard wifi status               Wi-Fi: radio, country, connection, and wired-vs-Wi-Fi priority
  zenithboard wifi on|off               turn Wi-Fi on or off (kept after a reboot)
  zenithboard wifi country XX           Wi-Fi country code, e.g. FR BE CH DE GB US (kept after a reboot)
  zenithboard wifi scan                 networks in range with signal strength
  zenithboard wifi connect SSID         save and join a network (asks for the password; hidden: add --hidden)
  zenithboard wifi install-nm           install NetworkManager if this Pi does not have it (run it with the cable plugged in)
  zenithboard wifi list|forget SSID     saved networks / forget one
  zenithboard region world|us           where the antenna is (us adds the optional 978 MHz UAT step in the menu)
  zenithboard units metric|imperial     km, km/h, m   |   mi, knots, ft
  zenithboard radius 1|2|5|10|15|30|50  wall detection radius (in your unit: km or miles)
  zenithboard location LAT LON [ALT_M]  set the antenna position EVERYWHERE it is stored
  zenithboard color amber|green|red|white|turquoise   dot colour of every wall (amber is the default)
  zenithboard mode dots|flap            look of the wall: dot matrix (default) or split-flap airport board
  zenithboard cycle SECONDS             seconds each aircraft stays on the wall
  zenithboard acars remove              take away ACARS and Grafana left by a ZenithBoard before 0.30.0 (asks a typed word)
  zenithboard patches on|off|status     Debian security fixes installed by themselves, daily (feeders left alone, no reboot)
  zenithboard security                  what this Pi does right now: who can read the wall, updates, SSH, ports, sandboxes
  zenithboard stats                     today, yesterday, 30 days, and messages per hour as a sparkline
  zenithboard stats on|off|status       collect a sample every 15 minutes (off by default; the page is /stats)
  zenithboard stats csv|clear           the raw samples / empty them
  zenithboard stats gaps                callsigns shown without an airline, types drawn with the generic silhouette (30 days)
  zenithboard graphs on|off|status      graphs1090: years of the decoder's graphs on port 8542 (off by default)
  zenithboard graphs look zenithboard|original   graphs1090's page and graphs in ZenithBoard's look, or its own (default)
  zenithboard tailscale on|off|status   reach the wall from anywhere through your own Tailscale network, no port opened (off by default)
  zenithboard tailscale remove          sign out, stop and uninstall Tailscale (asks you to type remove)
  zenithboard tailscale console on|off  the web console over Tailscale too (off by default: home networks only)
  zenithboard backup make [FILE]        everything to move to a new card: settings, features on, statistics, graphs,
                                        kept logs, the networks' identities (keep the file private)
  zenithboard backup show FILE          what a backup holds and the span of each part, read back as a restore would
  zenithboard backup list [DIR]         the backups, newest first (home folder and current folder by default)
  zenithboard backup clean [--keep N] [DIR]  delete the older backups, keep the N newest (3); asks you to type delete
  zenithboard backup delete --console   delete the copy the web console keeps for download
  zenithboard backup restore FILE       put it back on this Pi (asks you to type RESTORE; what was here is kept)
  zenithboard settings export [FILE]    your settings as one file (no secrets), to keep or to move to another Pi
  zenithboard settings import FILE      put them on this Pi (the ones from before are kept in a .bak file)
  zenithboard preset list|add|del       a name for a tablet's own choices: ?p=NAME in its address (add NAME theme=green mode=flap ...)
  zenithboard update quick              ZenithBoard and the wall only, in seconds (the feeders are left as they are)
  zenithboard wifi harden on|off|status retry without end after a loss and no radio power saving (off by default)
  zenithboard social setup              the Bluesky account (a wizard; asks for an app password, never the real one)
  zenithboard social words              the place name, the radius, the gap, the hashtags, what is worth a post
  zenithboard social hashtags [WORD...] the hashtags ending each post (# optional), none, or default; alone: show them
  zenithboard social gap [MINUTES]      the least time between two posts; 0 (the default) = none, every crossing posted
  zenithboard social picture            the picture: dot-matrix or split-flap, its colour, the map (a wizard)
  zenithboard social look dotmap|flap|alternate   the dot-matrix wall with a map, the split-flap board with a map, or the two in turn
  zenithboard social colour NAME|wall|rotate   amber, green, red, white, turquoise, the wall's own, or in turn
  zenithboard social units metric|imperial|wall   the posts' units, or the wall's own
  zenithboard social photolink on|off   end each post with a link to the aircraft's Planespotters photo page
  zenithboard social places on|off      name the towns on the maps from the region's own list (GeoNames, made on the Pi)
  zenithboard social sentence LIST      the words of a post: factual story board spotter lookup (several: a,b) or random
  zenithboard social summary [daily|weekly|monthly on|off|at TIME|parts LIST|test|post[2-4]]   summaries of 24 h, a week, 30 days (off by default; needs statistics)
  zenithboard social summary why        why a summary did not go out: as set, last and next, what it needs, the journal
  zenithboard social weekly ...         the same as: social summary weekly ...
  zenithboard social map NAME|rotate    the map of the dotmap and flap looks: normal, night, satellite, terrain, none, or in turn
  zenithboard social test [HEX]         draw the picture and print the text, post nothing (see it at /social/preview)
  zenithboard social on|off|status      post the aircraft overhead as a picture of the wall (off by default)
  zenithboard social post [HEX]         post now, once
  zenithboard social area [WORDS|none]  the place name the posts say (above Trémery, near Metz); never the position
  zenithboard social lang [CODE]        the posts' language: en (the default), fr, de, es... the pictures keep English
  zenithboard social template [list|tags|add TEXT|del N|set TEXT|undo|test [TEXT]]   your own post templates (the "custom" style); set none deletes them all, undo puts back the ones before
  zenithboard social radius [KM]        the sharing radius, 1 to 200 km (not the wall's)
  zenithboard social rules [all|LIST]   what is worth a post: all, or some of military,helicopter,heavy,rare,farthest
  zenithboard social check              try the account
  zenithboard social remove             forget the account, stop the service (asks you to type remove)
  zenithboard photos on|off             aircraft photos on the wall (needs internet on the Pi)
  zenithboard photos test [HEX]         check that this Pi can fetch photos from Planespotters
  zenithboard routes on|off             show where each flight comes from / goes to (looked up by callsign, needs internet)
  zenithboard data update               refresh the aircraft model list now (names for the silhouettes)
  zenithboard data auto on|off          monthly automatic refresh of that list (default: on)
  zenithboard data status               when it was last refreshed
  zenithboard data localdb on|off       read registrations and models from tar1090's database on this Pi (default: off)
  zenithboard update                    upgrade ZenithBoard + decoder + feeders
  zenithboard update list               what is installed and can be updated one by one
  zenithboard update only NAME...       update just those (e.g. readsb flightinfo)
  zenithboard mlat-guard                re-enforce a single MLAT client
  zenithboard adsbx-stats on|off|status|url   ADSB Exchange's stats: their map of only your aircraft, Feed Details on their page (off by default)
  zenithboard logs [flightinfo|decoder|uat|social|adsbexchange|piaware|fr24|planefinder]   show the last 100 lines of a service
  zenithboard logs usage|review         size of the system logs / size + recent warnings
  zenithboard logs limit MB|default     cap the size of the system logs (10-2000 MB)
  zenithboard logs clean                delete ALL logs now
  zenithboard logs auto on|off|status   automatic daily clean-up that keeps the last 7 days (off by default)
  zenithboard console on|off|status     the web console: settings from a browser on your network, /console (off by default)
  zenithboard console password          set its password (asked, never on the command line; signs everyone out)
  zenithboard console pair              a QR code that signs a phone in, once, within 5 minutes
  zenithboard console signout|forget    sign every browser out / turn it off and delete its password and records
  zenithboard console phone-signin on|off   a computer's sign-in page shows a QR code, a phone already signed in says yes (off by default)
  zenithboard menu                      open the installer menu (add / remove components)
USAGE
}

root_or_die() { [ "$(id -u)" -eq 0 ] || die "This command changes settings: run it with sudo."; }
root_or_zb()  { [ "$(id -u)" -eq 0 ] || [ "$(id -un)" = "$ZB_USER" ] || die "This command runs as root or as the $ZB_USER user (the timer does)."; }

show_state() { # show_state "Label" check_fn service
  local st="not installed"
  if "$2"; then if unit_active "$3"; then st="${C_G}running${C_0}"; else st="${C_R}installed, NOT running${C_0}"; fi; fi
  printf '  %-26s %s\n' "$1" "$st"
}

cmd_status() {
  local dec; dec=$(installed_decoder)
  echo "${C_B}ZenithBoard $ZB_VERSION${C_0}   units: $(cfg_get UNITS metric)   position: $(cfg_get LAT ?) , $(cfg_get LON ?)"
  if wifi_has_nm && [ -n "$(wifi_iface)" ]; then echo "Wi-Fi: $(wifi_summary)   (details: zenithboard wifi status)"; fi
  if [ "$(cfg_get DDNS_PROVIDER none)" != none ]; then echo "Domain name: $(ddns_summary)   (details: zenithboard ddns status)"; fi
  echo "Hardware: $(pi_model || true)  RAM: $(mem_avail_mb) / $(mem_total_mb) MB free$(is_low_mem && echo '  (1 GB: enough for everything, see wiki Hardware)')"
  echo "Decoder / feeders:"
  if [ -n "$dec" ]; then show_state "Decoder ($dec)" true "$dec"; else echo "  Decoder                    not installed"; fi
  show_state "ADSB Exchange" is_adsbx adsbexchange-feed
  if is_adsbx_stats; then show_state "ADSB Exchange stats" true adsbexchange-stats
  elif is_adsbx; then printf '  %-26s %s\n' "ADSB Exchange stats" "off (their map of your aircraft: sudo zenithboard adsbx-stats on)"; fi
  show_state "FlightAware (piaware)" is_piaware piaware
  show_state "Flightradar24" is_fr24 fr24feed
  show_state "Plane Finder" is_planefinder pfclient
  if is_region_us || is_uat978; then show_state "978 MHz UAT (dump978-fa)" is_uat978 dump978-fa; fi
  echo "Displays:"
  show_state "FlightInfo wall" is_flightinfo zenithboard-flightinfo
  if is_graphs; then show_state "graphs1090 (port $GRAPHS_PORT)" true graphs1090; fi
  local n; n=$(mlat_count)
  if [ "${n:-0}" = 0 ] && is_adsbx; then echo "MLAT clients running: 0  ${C_Y}(none: ADSB Exchange's MLAT is not running, see: zenithboard logs adsbexchange)${C_0}"
  elif [ "${n:-0}" -le 1 ]; then echo "MLAT clients running: ${n:-0}  ${C_G}(OK: max 1)${C_0}"; else echo "MLAT clients running: $n  ${C_R}(too many! run: sudo zenithboard mlat-guard)${C_0}"; fi
  local j; j=$(decoder_json)
  if [ -f "$j" ]; then echo "Aircraft in decoder right now: $(grep -o '"hex"' "$j" | wc -l)"; fi
  if is_uat978 && [ -f /run/skyaware978/aircraft.json ]; then echo "Aircraft on 978 MHz right now:  $(grep -o '"hex"' /run/skyaware978/aircraft.json | wc -l)"; fi
  if is_flightinfo; then
    echo "Wall:     http://$(local_ip):$(cfg_get PORT 8080)/"
    echo "Aircraft photos (Planespotters): $( [ "$(cfg_get SHOW_PHOTOS 1)" = 1 ] && echo "ON" || echo "OFF (turn on: sudo zenithboard photos on)" )"
    echo "Flight routes (adsbdb.com):      $( [ "$(cfg_get SHOW_ROUTES 1)" = 1 ] && echo "ON" || echo "OFF (turn on: sudo zenithboard routes on)" )"
    data_refresh_status
    localdb_status
  fi
  if is_adsbx; then
    local m; m=$(local_map_path)
    echo "Local map: http://$(local_ip)$m   (port 80, no clash with the wall on $(cfg_get PORT 8080))"
    echo "ADSB Exchange feed status: https://www.adsbexchange.com/myip/"
  fi
  acars_notice
}

# The map served on port 80 comes from readsb (tar1090) or from the optional ADSB Exchange web interface,
# so look for the one that is actually installed instead of guessing.
local_map_path() {
  local d
  for d in /usr/local/share/tar1090/html /usr/share/tar1090/html; do [ -d "$d" ] && { echo "/tar1090/"; return; }; done
  for d in /usr/local/share/adsbexchange/html /usr/share/adsbexchange/html; do [ -d "$d" ] && { echo "/adsbx/"; return; }; done
  echo "/tar1090/  (or /adsbx/ if you installed the ADSB Exchange web interface)"
}

data_refresh_status() {
  local f="$ZB_DATA/data/types.json"
  echo "Monthly aircraft data refresh: $( [ "$(cfg_get AUTO_DATA_REFRESH 1)" = 1 ] && echo ON || echo OFF )"
  if [ -f "$f" ]; then
    python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print("Aircraft list: %s types, downloaded %s" % (d.get("count"), d.get("updated")))' "$f" 2>/dev/null || echo "Aircraft list: present but unreadable (run: sudo zenithboard data update)"
  elif [ ! -x "$ZB_DATA" ]; then
    echo "Aircraft list: cannot be checked by $(id -un) (older install: run 'sudo zenithboard update' once to fix the folder permissions)"
  else
    echo "Aircraft list: not downloaded (built-in list in use; run: sudo zenithboard data update)"
  fi
}

# 0.26.0: the receiver map's own aircraft database (tar1090), read on the card: registrations and models that adsbdb
# and hexdb do not know (EWG8QR, 9H-EWG, went out without them). Off by default.
localdb_dir() { cfg_get LOCAL_DB_DIR /usr/local/share/tar1090/git-db/db; }
localdb_status() {
  local d v; d=$(localdb_dir); v=$(cat "${d%/db}/version" 2>/dev/null)
  if [ "$(cfg_get LOCAL_DB 0)" = 1 ]; then
    if [ -d "$d" ]; then echo "Aircraft database on this Pi (tar1090): ON, version ${v:-unknown}  ($d)"
    else echo "Aircraft database on this Pi (tar1090): ON, but $d is missing (install the receiver map, tar1090)"; fi
  else
    echo "Aircraft database on this Pi (tar1090): OFF$( [ -d "$d" ] && echo " (found, version ${v:-unknown}; turn on: sudo zenithboard data localdb on)" )"
  fi
}
localdb_set() {
  local d; d=$(localdb_dir)
  if [ "$1" = 1 ] && [ ! -d "$d" ]; then
    die "No tar1090 aircraft database at $d. It comes with the receiver map (tar1090); another folder: sudo zenithboard config-set LOCAL_DB_DIR /path/to/db"
  fi
  cfg_set LOCAL_DB "$1"; restart_flightinfo
  if [ "$1" = 1 ]; then echo "The wall now reads registrations and models from tar1090's database on this Pi first ($d), then asks adsbdb and hexdb for the rest. Nothing is downloaded: tar1090 keeps it up to date."
  else echo "The wall no longer reads tar1090's database: registrations and models come from the decoder, adsbdb and hexdb, as before."; fi
}

cmd_config() { echo "# $ZB_CONFIG"; cat "$ZB_CONFIG" 2>/dev/null || echo "(no configuration yet - run: sudo ./install.sh)"; }

case "${1:-}" in
  status) cmd_status ;;
  config|"show") cmd_config ;;
  units)
    root_or_die; valid_units "${2:-}" || die "Usage: zenithboard units metric|imperial"
    cfg_set UNITS "$2"; restart_flightinfo
    echo "Units are now $2. Radius ($(cfg_get RADIUS)) is read as $( [ "$2" = imperial ] && echo miles || echo km ). Tablets with their own on-screen override: tap the gear on the wall." ;;
  radius)
    root_or_die; valid_radius "${2:-}" || die "Radius must be one of: $RADIUS_PRESETS"
    cfg_set RADIUS "$2"; restart_flightinfo; echo "Radius: $2 $( [ "$(cfg_get UNITS)" = imperial ] && echo mi || echo km )" ;;
  location)
    root_or_die; valid_lat "${2:-x}" && valid_lon "${3:-x}" || die "Usage: zenithboard location LAT LON [ALT_M]   e.g. 49.1193 6.1757 180"
    zb_apply_location "$2" "$3" "${4:-}" ;;
  color|colour)
    root_or_die; valid_theme "${2:-}" || die "Usage: zenithboard color amber|green|red|white|turquoise   (blue was taken out in 0.23.0)"
    cfg_set THEME "$2"; restart_flightinfo
    graphs_look_keep                                # 0.43.0: graphs1090 in ZenithBoard's look takes the new colour too
    echo "Wall colour is now $2 (tablets that picked their own colour with the gear keep it: use the gear's Reset)." ;;
  data)
    case "${2:-status}" in
      update) root_or_die; ensure_zb_user; data_refresh_now ;;
      auto)
        root_or_die
        case "${3:-}" in on) cfg_set AUTO_DATA_REFRESH 1 ;; off) cfg_set AUTO_DATA_REFRESH 0 ;; *) die "Usage: zenithboard data auto on|off" ;; esac
        data_refresh_apply
        echo "Monthly aircraft data refresh: $( [ "$(cfg_get AUTO_DATA_REFRESH 1)" = 1 ] && echo ON || echo OFF )" ;;
      localdb)
        [ -z "${3:-}" ] || root_or_die
        case "${3:-}" in
          on)  localdb_set 1 ;;
          off) localdb_set 0 ;;
          "")  localdb_status ;;
          *)   die "Usage: zenithboard data localdb on|off" ;;
        esac ;;
      status) data_refresh_status; localdb_status ;;
      *) die "Usage: zenithboard data update | auto on|off | localdb on|off | status" ;;
    esac ;;
  tailscale)
    case "${2:-status}" in
      on) root_or_die; tailscale_on ;;
      off) root_or_die; tailscale_off ;;
      remove) root_or_die; tailscale_remove "${3:-}" ;;
      console) root_or_die; tailscale_console "${3:-}" ;;
      status) tailscale_status ;;
      *) die "Usage: zenithboard tailscale on|off|status|remove|console on|off" ;;
    esac ;;
  backup)
    case "${2:-}" in
      make) root_or_die; shift 2; backup_make "$@" ;;
      show) [ -n "${3:-}" ] || die "Usage: zenithboard backup show FILE"; backup_show "$3" ;;
      list) backup_list "${3:-}" ;;
      clean) shift 2; backup_clean "$@" ;;
      delete) root_or_die; [ "${3:-}" = --console ] || die "Usage: sudo zenithboard backup delete --console   (your own backups: rm, or backup clean)"; backup_delete_console ;;
      restore) root_or_die; [ -n "${3:-}" ] || die "Usage: sudo zenithboard backup restore FILE"; shift 2; backup_restore "$@" ;;
      *) die "Usage: sudo zenithboard backup make [FILE] | show FILE | list [DIR] | clean [--keep N] [DIR] | restore FILE | delete --console" ;;
    esac ;;
  settings)
    case "${2:-}" in
      export) settings_export "${3:-}" ;;
      import) root_or_die; [ -n "${3:-}" ] || die "Usage: sudo zenithboard settings import FILE"; settings_import "$3" && settings_apply ;;
      *) die "Usage: zenithboard settings export [FILE]   |   sudo zenithboard settings import FILE" ;;
    esac ;;
  preset|presets)
    case "${2:-list}" in
      list) preset_list ;;
      add) root_or_die; [ -n "${3:-}" ] || die "Usage: sudo zenithboard preset add NAME key=value...   (keys: $PRESET_KEYS)"; preset_add "${@:3}" ;;
      del|rm|forget) root_or_die; [ -n "${3:-}" ] || die "Usage: sudo zenithboard preset del NAME"; preset_del "$3" ;;
      *) die "Usage: zenithboard preset list | add NAME key=value... | del NAME" ;;
    esac ;;
  config-set)
    root_or_die; [ -n "${2:-}" ] || die "Usage: zenithboard config-set KEY VALUE"; cfg_set "$2" "${3:-}"; restart_flightinfo ;;
  mode|style)
    case "${2:-}" in
      dots|flap) root_or_die; cfg_set DISPLAY_MODE "$2"; restart_flightinfo
                 echo "Look of the wall: $2. The wall reloads by itself. A tablet that chose its own look keeps it: open the gear on the wall and press Reset, or use  ?mode=$2  in its address." ;;
      "") echo "Look of the wall: $(cfg_get DISPLAY_MODE dots)   (change: sudo zenithboard mode dots|flap)" ;;
      *) die "Usage: zenithboard mode dots|flap" ;;
    esac ;;
  cycle)
    root_or_die; is_number "${2:-x}" || die "Usage: zenithboard cycle SECONDS"; cfg_set CYCLE_SECONDS "$2"; restart_flightinfo ;;
  security) security_check ;;
  stats)
    case "${2:-show}" in
      show)   stats_show ;;
      on)     root_or_die; stats_on ;;
      off)    root_or_die; stats_off ;;
      run)    root_or_zb; stats_run ;;
      status) stats_status ;;
      csv)    stats_csv ;;
      gaps)   stats_gaps ;;
      clear)  root_or_die; stats_clear ;;
      *) die "Usage: zenithboard stats [on|off|status|csv|gaps|clear]" ;;
    esac ;;
  graphs|graphs1090)
    case "${2:-status}" in
      on)     root_or_die; graphs_on ;;
      off)    root_or_die; graphs_off ;;
      status) graphs_status ;;
      look)   [ "${3:-status}" = status ] || root_or_die; graphs_look "${3:-status}" ;;
      *) die "Usage: zenithboard graphs on|off|status|look zenithboard|original" ;;
    esac ;;
  social)
    case "${2:-status}" in
      setup)  root_or_die; social_setup ;;
      words)  root_or_die; social_setup_words && echo "Saved." ;;
      picture) root_or_die; social_setup_picture ;;
      hashtags|tags) if [ -n "${3:-}" ]; then root_or_die; fi; social_set_hashtags "${@:3}" ;;
      gap)    if [ -n "${3:-}" ]; then root_or_die; fi; social_set_gap "${3:-}" ;;
      look)   root_or_die; social_set_look "${3:-}" ;;
      colour|color) root_or_die; social_set_colour "${3:-}" ;;
      units) root_or_die; social_set_units "${3:-}" ;;
      photolink) [ -z "${3:-}" ] || root_or_die; social_set_photolink "${3:-}" ;;
      places) [ -z "${3:-}" ] || root_or_die; social_set_places "${3:-}" ;;
      sentence|sentences) [ -z "${3:-}" ] || root_or_die; social_set_sentence "${3:-}" ;;
      map)    root_or_die; social_set_map "${3:-}" ;;
      on)     root_or_die; social_on ;;
      off)    root_or_die; social_off ;;
      test)   root_or_zb; social_need_tools && social_prepare_dir && { [ "$(id -u)" -ne 0 ] && python3 "$SOCIAL_PY" test "${3:-}" || sudo -u "$ZB_USER" python3 "$SOCIAL_PY" test "${3:-}"; } ;;
      area)   [ -z "${*:3}" ] || root_or_die; social_set_area "${@:3}" ;;
      lang)   [ -z "${3:-}" ] || root_or_die; social_set_lang "${3:-}" ;;
      template|templates) case "${3:-list}" in list|tags|test) ;; *) root_or_die ;; esac; social_template "${@:3}" ;;
      radius) [ -z "${3:-}" ] || root_or_die; social_set_radius "${3:-}" ;;
      rules)  [ -z "${3:-}" ] || root_or_die; social_set_rules "${3:-}" ;;
      post)   root_or_zb; social_need_tools && social_prepare_dir && { [ "$(id -u)" -ne 0 ] && python3 "$SOCIAL_PY" post "${3:-}" || sudo -u "$ZB_USER" python3 "$SOCIAL_PY" post "${3:-}"; } ;;
      weekly|summary)
        # 0.38.0: `social summary daily|weekly|monthly ...`; `social weekly ...` (0.33.0) is the weekly one
        if [ "$2" = weekly ]; then set -- social summary weekly "${@:3}"; fi
        case "${4:-}" in
          test|post|post2|post3|post4)
            root_or_zb; social_need_tools && social_prepare_dir || exit 1
            if [ "$4" = test ]; then a=(summary-test "$3"); else n=${4#post}; a=(summary-post "$3" "${n:-1}"); fi
            if [ "$(id -u)" -ne 0 ]; then python3 "$SOCIAL_PY" "${a[@]}"; else sudo -u "$ZB_USER" python3 "$SOCIAL_PY" "${a[@]}"; fi ;;
          *) [ -z "${4:-}" ] || root_or_die; social_summary "${@:3}" ;;
        esac ;;
      check)  root_or_die; python3 "$SOCIAL_PY" check ;;
      status) social_status ;;
      remove) root_or_die; social_remove "${3:-}" ;;
      *) die "Usage: zenithboard social setup|words|hashtags [WORD...]|gap [MINUTES]|picture|look dotmap|flap|alternate|colour NAME|units metric|imperial|wall|photolink on|off|places on|off|sentence LIST|summary daily|weekly|monthly on|off|at TIME|parts LIST|test|post[2-4]|map NAME|area WORDS|radius KM|rules LIST|lang CODE|template ...|on|off|test [HEX]|post [HEX]|check|status|remove" ;;
    esac ;;
  patches)
    case "${2:-status}" in
      on)  root_or_die; patches_on ;;
      off) root_or_die; patches_off ;;
      status) patches_status ;;
      *) die "Usage: zenithboard patches on|off|status" ;;
    esac ;;
  acars)
    case "${2:-}" in
      remove) root_or_die; acars_remove ;;
      *) die "Usage: sudo zenithboard acars remove   (ACARS and Grafana are no longer part of ZenithBoard since 0.30.0)" ;;
    esac ;;
  photos)
    case "${2:-}" in
      on)  root_or_die; cfg_set SHOW_PHOTOS 1; restart_flightinfo; echo "Aircraft photos are ON. The wall reloads by itself within a few seconds." ;;
      off) root_or_die; cfg_set SHOW_PHOTOS 0; restart_flightinfo; echo "Aircraft photos are OFF: the animated sky scene is shown instead." ;;
      test) python3 "$ZB_HOME/tools/photo_check.py" "${3:-}" ;;
      *) die "Usage: zenithboard photos on|off|test [HEX]" ;;
    esac ;;
  routes)
    [ "${2:-}" != test ] || { python3 "$ZB_HOME/tools/route_check.py" "${3:-}"; exit $?; }
    root_or_die
    case "${2:-}" in
      on)  cfg_set SHOW_ROUTES 1; restart_flightinfo; echo "Flight routes are ON (origin and destination, looked up by callsign). The wall reloads by itself." ;;
      off) cfg_set SHOW_ROUTES 0; restart_flightinfo; echo "Flight routes are OFF: no callsign is sent to the internet." ;;
      *) die "Usage: zenithboard routes on|off|test [CALLSIGN]" ;;
    esac ;;
  mlat-guard) root_or_die; zb_mlat_guard ;;
  adsbx-stats)                                    # 0.52.0: ADSB Exchange's stats package, optional
    case "${2:-status}" in
      on)     root_or_die; adsbx_stats_on ;;
      off)    root_or_die; adsbx_stats_off ;;
      status) adsbx_stats_status ;;
      url)    adsbx_stats_url || die "No ADSB Exchange UUID on this Pi: install ADSB Exchange first (menu 1 ADS-B → 1 Decoder and networks)." ;;
      *) die "Usage: zenithboard adsbx-stats on|off|status|url" ;;
    esac ;;
  update)
    case "${2:-}" in
      list) zb_update_list ;;
      quick) root_or_die; if is_flightinfo; then zb_update --only zenithboard flightinfo; else zb_update --only zenithboard; fi ;;
      only) root_or_die; [ -n "${3:-}" ] || die "Usage: sudo zenithboard update only NAME...   (names: zenithboard readsb dump1090 adsbx piaware fr24 planefinder flightinfo graphs1090; see: zenithboard update list)"; shift 2; zb_update --only "$@" ;;
      *) root_or_die; zb_update "${2:-}" ;;
    esac ;;
  update-components) root_or_die; shift; zb_update_components "$@" ;;
  net)
    case "${2:-status}" in
      status) net_status ;;
      static)
        root_or_die; net_has_nm || die "A fixed address needs NetworkManager."
        [ -n "${3:-}" ] && [ -n "${4:-}" ] && [ -n "${5:-}" ] || die "Usage: sudo zenithboard net static IP MASK GATEWAY [cloudflare|google|router|\"DNS DNS\"] [PROFILE-NAME]"
        net_valid_host_ip "$3" || die "Not a valid address: $3"
        p=$(net_to_prefix "$4") || die "Not a valid mask: $4 (try 255.255.255.0 or 24)"
        net_valid_host_ip "$5" || die "Not a valid gateway: $5"
        net_same_subnet "$3" "$5" "$p" || die "The gateway $5 is not in the network of $3/$p: the Pi would lose its connection."
        dns=$(net_dns_preset "${6:-cloudflare}" "$5"); net_valid_dns_list "$dns" || die "Not a valid DNS list: ${6:-}"
        if [ -n "${7:-}" ]; then u=$(net_profiles | awk -F'\t' -v n="$7" '$3==n {print $1; exit}'); else u=$(net_default_profile); fi
        [ -n "$u" ] || die "Which connection? Give its name (see: zenithboard net status) as the last argument."
        net_session_uses "$u" && warn "You are connected through this connection: the session will drop. Reconnect at $3."
        net_apply_static "$u" "$3" "$p" "$5" "$dns" && echo "Fixed address saved: $3/$p via $5, DNS $dns (kept after a reboot). Undo: sudo zenithboard net dhcp" || die "Could not apply it. Check: zenithboard net status" ;;
      dhcp)
        root_or_die; net_has_nm || die "NetworkManager is not running."
        if [ -n "${3:-}" ]; then u=$(net_profiles | awk -F'\t' -v n="$3" '$3==n {print $1; exit}'); else u=$(net_default_profile); fi
        [ -n "$u" ] || die "Which connection? Give its name (see: zenithboard net status)."
        net_apply_dhcp "$u" && echo "Automatic address restored." || die "Could not apply it." ;;
      *) die "Usage: zenithboard net status|static IP MASK GATEWAY [DNS]|dhcp" ;;
    esac ;;
  health) health_check ;;
  memory|threads) python3 "$ZB_HOME/tools/memory_report.py" ;;
  watchdog) case "${2:-status}" in on) root_or_die; watchdog_on ;; off) root_or_die; watchdog_off ;; status) echo "Hardware watchdog: $(watchdog_state)" ;; *) die "Usage: zenithboard watchdog on|off|status" ;; esac ;;
  keeplogs) case "${2:-status}" in on) root_or_die; keeplogs_on ;; off) root_or_die; keeplogs_off ;; status) echo "Logs kept after a restart: $(keeplogs_state)" ;; *) die "Usage: zenithboard keeplogs on|off|status" ;; esac ;;
  netwatch) case "${2:-status}" in on) root_or_die; netwatch_on ;; off) root_or_die; netwatch_off ;; run) root_or_die; netwatch_run ;; status) netwatch_status ;; *) die "Usage: zenithboard netwatch on|off|status" ;; esac ;;
  gain)
    case "${2:-check}" in
      check|status) gain_check ;;
      set) root_or_die; [ -n "${3:-}" ] || die "Usage: sudo zenithboard gain set DB|max|default"; gain_set "$3" ;;
      up|down) root_or_die; d=$(gain_decoder); gain_set "$(gain_step_move "$(gain_current "$d")" "$2")" ;;
      steps) echo "$GAIN_STEPS" ;;
      log)
        case "${3:-status}" in
          on)     root_or_die; gain_log_start ;;
          off)    root_or_die; gain_log_stop ;;
          run)    root_or_zb; gain_log_run ;;
          show)   gain_log_show ;;
          clear)  root_or_die; gain_log_clear ;;
          path)   gain_log_path ;;
          status) gain_log_status ;;
          *) die "Usage: zenithboard gain log on|off|status|show|clear|path" ;;
        esac ;;
      *) die "Usage: zenithboard gain check | set DB|max|default | up | down | steps | log on|off|status|show|clear" ;;
    esac ;;
  ddns)
    case "${2:-status}" in
      status) ddns_status; [ "$(cfg_get DDNS_PROVIDER none)" = none ] || { echo; ddns_links; } ;;
      update) root_or_die; ddns_update && cat "$DDNS_STATE" 2>/dev/null || { cat "$DDNS_STATE" 2>/dev/null; exit 1; } ;;
      test) root_or_die; ddns_test ;;
      off) root_or_die; ddns_off; echo "Domain name is off; the saved key was deleted." ;;
      set)
        root_or_die; [ -n "${3:-}" ] && [ -n "${4:-}" ] || die "Usage: sudo zenithboard ddns set duckdns|noip|freedns FULL.NAME"
        u=""; if [ "$3" = noip ]; then read -rp "No-IP DDNS key user name: " u; read -rsp "No-IP DDNS key password: " s; echo
        else read -rsp "Token (or the whole FreeDNS direct URL): " s; echo; fi
        ddns_set "$3" "$4" "$u" "$s" ;;
      *) die "Usage: zenithboard ddns status|set PROVIDER NAME|update|off" ;;
    esac ;;
  wifi)
    case "${2:-status}" in
      status) wifi_status ;;
      on|off) root_or_die; wifi_has_nm || die "Wi-Fi needs NetworkManager. Install it with:  sudo zenithboard wifi install-nm"; [ "$2" = off ] && wifi_session_on_wifi && warn "You seem to be connected through Wi-Fi: turning it off will cut this session."
              [ "$2" = on ] && [ -z "$(wifi_country_now)" ] && die "Set the country first:  sudo zenithboard wifi country FR"
              wifi_set_radio "$2" && echo "Wi-Fi is $2 (kept after a reboot)." ;;
      country) root_or_die; wifi_set_country "${3:-}" && echo "Wi-Fi country: $3 (kept after a reboot)." ;;
      scan) wifi_has_nm || die "Wi-Fi needs NetworkManager."; wifi_radio_on || die "Wi-Fi is off: sudo zenithboard wifi on"
            wifi_scan | while IFS=$'\t' read -r ssid sig sec; do printf '%-6s %3s%%  %-32s %s\n' "$(wifi_bars "$sig")" "$sig" "$ssid" "$sec"; done ;;
      connect)
        root_or_die; wifi_has_nm || die "Wi-Fi needs NetworkManager."; [ -n "${3:-}" ] || die "Usage: zenithboard wifi connect SSID [--hidden]   (the password is asked, never typed on the command line)"
        [ -n "$(wifi_country_now)" ] || die "Set the country first:  sudo zenithboard wifi country FR"
        wifi_session_on_wifi && warn "You seem to be connected through Wi-Fi: this may cut your session."
        psk="${ZB_WIFI_PSK:-}"
        [ -n "$psk" ] || { read -rsp "Password for \"$3\" (empty = open network): " psk; echo; }
        hid=0; [ "${4:-}" = --hidden ] && hid=1
        wifi_connect "$3" "$psk" "$hid" wpa-psk ;;
      list) wifi_saved | cut -f2 ;;
      forget)
        root_or_die; [ -n "${3:-}" ] || die "Usage: zenithboard wifi forget SSID"
        u=$(wifi_saved | awk -F'\t' -v n="$3" '$2==n || $2 ~ ("^zenithboard-wifi-" n "-") {print $1; exit}')
        [ -n "$u" ] || die "No saved network called $3 (see: zenithboard wifi list)"
        wifi_forget "$u" && echo "Forgotten: $3" ;;
      install-nm) root_or_die; wifi_install_nm ;;
      harden)
        case "${3:-status}" in
          on)  root_or_die; wifi_has_nm || die "Wi-Fi hardening needs NetworkManager."; wifi_harden_on ;;
          off) root_or_die; wifi_harden_off ;;
          status) wifi_harden_status ;;
          *) die "Usage: zenithboard wifi harden on|off|status" ;;
        esac ;;
      apply) root_or_die; wifi_apply ;;
      *) die "Usage: zenithboard wifi status|on|off|country XX|scan|connect SSID|list|forget SSID" ;;
    esac ;;
  region)
    case "${2:-}" in
      world|us) root_or_die; cfg_set REGION "$2"; echo "Region: $2. $( [ "$2" = us ] && echo "Menu 1 ADS-B → 1 Decoder and networks now offers the 978 MHz UAT step (needs a 2nd dongle)." || echo "1090 MHz only." )" ;;
      "") echo "Region: $(cfg_get REGION world)" ;;
      *) die "Usage: zenithboard region world|us" ;;
    esac ;;
  logs)
    case "${2:-flightinfo}" in
      usage) logs_usage ;;
      review) logs_review ;;
      limit) root_or_die; logs_set_limit "${3:-}" ;;
      clean) root_or_die; logs_clean "${3:-all}" ;;
      auto) root_or_die; case "${3:-status}" in on) logs_auto_on; echo "Automatic cleaning is ON: every day, logs older than 7 days are removed." ;; off) logs_auto_off; echo "Automatic cleaning is OFF." ;; status) echo "Automatic cleaning: $(logs_auto_state)" ;; *) die "Usage: zenithboard logs auto on|off|status" ;; esac ;;
      auto-run) root_or_die; logs_auto_run ;;
      uat) journalctl -u dump978-fa -u skyaware978 -n 100 --no-pager ;;
      flightinfo) journalctl -u zenithboard-flightinfo -n 100 --no-pager ;;
      social) journalctl -u zenithboard-social -n 100 --no-pager ;;
      decoder) journalctl -u "$(cfg_get DECODER readsb)" -n 100 --no-pager ;;
      # 0.54.6: a feeder that fails had no log to read: the names are the ones `status` uses
      adsbexchange|piaware|fr24|planefinder)
        u=$(case "${2:-}" in adsbexchange) echo adsbexchange-feed ;; piaware) echo piaware ;; fr24) echo fr24feed ;; planefinder) echo pfclient ;; esac)
        if systemctl list-unit-files "$u.service" 2>/dev/null | grep -q "^$u.service"; then journalctl -u "$u" -n 100 --no-pager
        else echo "$u is not installed on this Pi: nothing to show."; fi ;;
      *) die "Usage: zenithboard logs [flightinfo|decoder|uat|social|adsbexchange|piaware|fr24|planefinder]" ;;
    esac ;;
  console)
    case "${2:-status}" in
      on)       root_or_die; console_on ;;
      off)      root_or_die; console_off ;;
      status)   console_status ;;
      password) root_or_die; console_password ;;
      pair)     root_or_die; console_pair ;;
      signout)  root_or_die; console_signout ;;
      forget)   root_or_die; console_forget ;;
      phone-signin) [ -z "${3:-}" ] || root_or_die; console_phone_signin "${3:-}" ;;
      state)    root_or_die; console_state_lines ;;
      lang)     [ -z "${3:-}" ] || root_or_die; console_lang "${3:-}" ;;
      *) die "Usage: zenithboard console on|off|status|password|pair|signout|forget|lang [CODE]" ;;
    esac ;;
  menu) root_or_die; exec "$HERE/../install.sh" ;;
  version|--version) echo "ZenithBoard $ZB_VERSION" ;;
  help|-h|--help|"") usage ;;
  *) usage; exit 1 ;;
esac
